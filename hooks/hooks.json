{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mem context --project \"$PWD\" --inject --limit 10 --format silent",
            "description": "Load relevant memories at session start",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mem extract --auto --session \"$CLAUDE_SESSION_ID\" --quiet",
            "description": "Extract key learnings before context window compaction",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mem session end --session \"$CLAUDE_SESSION_ID\" --summarize",
            "description": "Finalize session and generate summary",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "mem track-file \"$TOOL_INPUT_FILE_PATH\" --session \"$CLAUDE_SESSION_ID\"",
            "description": "Track files modified for context",
            "timeout": 2000
          }
        ]
      }
    ]
  }
}
