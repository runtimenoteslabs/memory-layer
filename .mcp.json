{
  "mcpServers": {
    "runtime-memory": {
      "command": "mem",
      "args": ["serve", "--mcp"],
      "env": {
        "RUNTIME_MEMORY_DB": "~/.runtime-memory/memories.db",
        "RUNTIME_MEMORY_LOG_LEVEL": "WARNING"
      },
      "description": "Runtime Memory MCP server - persistent memory with outcome-based learning"
    }
  }
}
