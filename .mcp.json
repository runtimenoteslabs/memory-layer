{
  "mcpServers": {
    "memory-layer": {
      "command": "mem",
      "args": ["serve", "--mcp"],
      "env": {
        "MEMORY_LAYER_DB": "~/.memory-layer/memories.db",
        "MEMORY_LAYER_LOG_LEVEL": "WARNING"
      },
      "description": "Memory Layer MCP server - persistent memory with outcome-based learning"
    }
  }
}
